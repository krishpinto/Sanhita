# Copy to .env and fill in real values. .env is gitignored.
#
# This build has no LLM calls and no backend — see CLAUDE.md, "What NOT to
# build yet". There is nothing required here yet. The one variable below is
# for the future "remote protocol delivery" item in the build order
# (CLAUDE.md, build item 5) — unused until then.

# Where the app fetches versioned Protocol Definition files from, once
# protocols are no longer bundled into the build. Leave unset for now — the
# app runs entirely off the protocols bundled in src/lib/protocols.
EXPO_PUBLIC_PROTOCOL_SOURCE_URL=
